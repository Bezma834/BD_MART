            "url": {
              "raw": "{{BASE_URL}}/api/v1/delivery/partners-near?latitude=11.60&longitude=37.06",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "delivery",
                "partners-near"
