            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teff Seeds\",\n  \"description\": \"High-quality teff seeds for farming\",\n  \"price\": 500.00,\n  \"category\": \"food\",\n  \"subcategory\": \"agriculture\",\n  \"stock\": 100\n}"
