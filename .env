# BD_MART Environment Configuration
# Copy this file to .env and replace with your actual values

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/bd_mart

# Hasura
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=myadminsecretkey

# Authentication
JWT_SECRET=your_very_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Payment (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloud Services (Maps - optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# CORS
CORS_ORIGIN=http://localhost:3000,exp://localhost:8081

# EthioPay/Sawtell (local payment gateways - optional)
ETHIOPAY_MERCHANT_ID=
ETHIOPAY_PRIVATE_KEY=